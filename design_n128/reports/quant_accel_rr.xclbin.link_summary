<ENTRY>
{
 "type": "ET_CmdStep",
 "dateTimestamp": "Thu Sep 24 16:32:36 2026",
 "timestampMillis": "1790238756615",
 "buildStep": {
  "cmdId": "ee5c30c0-bd57-4d9b-888b-817846dc3523",
  "name": "v++",
  "logFile": "/home/eeuser/quant_accel/source_rr/_x/link/link.steps.log",
  "commandLine": "/home/eeuser/xilinx/Vitis/2022.1/bin/unwrapped/lnx64.o/v++  --vivado.prop \"run.__KERNEL__.{STEPS.SYNTH_DESIGN.ARGS.MORE OPTIONS}={-directive sdx_optimization_effort_high}\" --advanced.misc \"report=type report_timing_summary name impl_report_timing_summary_route_design_summary steps {route_design} runs {impl_1} options {-max_paths 10}\" --advanced.misc \"report=type report_timing_summary name impl_report_timing_summary_post_route_phys_opt_design_summary steps {post_route_phys_opt_design} runs {impl_1} options {-max_paths 10}\" -l -t hw --platform /opt/xilinx/platforms/xilinx_u50_gen3x16_xdma_5_202210_1/xilinx_u50_gen3x16_xdma_5_202210_1.xpfm --config /home/eeuser/quant_accel/vitis/quant_accel_rr.cfg -o quant_accel_rr.xclbin upd_inject.xo lob_filter.xo inctsvd_top.xo sv_bcast3.xo sv_bcast2.xo momentum_signal.xo risk_matrix.xo regime_classifier.xo decision_sink.xo ",
  "args": [
   "-l",
   "-t",
   "hw",
   "--platform",
   "/opt/xilinx/platforms/xilinx_u50_gen3x16_xdma_5_202210_1/xilinx_u50_gen3x16_xdma_5_202210_1.xpfm",
   "--config",
   "/home/eeuser/quant_accel/vitis/quant_accel_rr.cfg",
   "-o",
   "quant_accel_rr.xclbin",
   "upd_inject.xo",
   "lob_filter.xo",
   "inctsvd_top.xo",
   "sv_bcast3.xo",
   "sv_bcast2.xo",
   "momentum_signal.xo",
   "risk_matrix.xo",
   "regime_classifier.xo",
   "decision_sink.xo"
  ],
  "iniFiles": [
   {
    "path": "/home/eeuser/quant_accel/vitis/quant_accel_rr.cfg",
    "content": "# ─────────────────────────────────────────────────────────────────────────────\n# quant_accel.cfg — v++ link configuration (Option B)\n#\n# Adds decision_sink, moves the two DMA endpoints (upd_inject, decision_sink)\n# onto HBM, and wires the three app result streams into the sink. stream_connect\n# is strictly point-to-point, which is why sv_bcast3/sv_bcast2 exist.\n# ─────────────────────────────────────────────────────────────────────────────\nplatform=/opt/xilinx/platforms/xilinx_u50_gen3x16_xdma_5_202210_1/xilinx_u50_gen3x16_xdma_5_202210_1.xpfm\n\n[connectivity]\nnk=upd_inject:1:upd_inject\nnk=lob_filter:1:lob_filter\nnk=inctsvd_top:1:inctsvd_top\nnk=sv_bcast3:1:bcast_st\nnk=sv_bcast2:1:bcast_pm\nnk=momentum_signal:1:momentum_signal\nnk=risk_matrix:1:risk_matrix\nnk=regime_classifier:1:regime_classifier\nnk=decision_sink:1:decision_sink\n\n# ── DMA endpoints -\u003e HBM ─────────────────────────────────────────────────────\n# NEW in B: Option A used no HBM at all. The feeder reads the packed update\n# batch from HBM; the sink writes the decision batch back. Both buffers are tiny\n# (a few hundred × 32/40 B), so any pseudo-channel is fine; kept on separate\n# banks so the in/out bursts never contend.\nsp=upd_inject.updates:HBM[0]\nsp=decision_sink.decisions:HBM[1]\n\n\n# ── FIFO depths ──────────────────────────────────────────────────────────────\n# The :N suffix on each stream_connect sets the FIFO depth in beats (default is\n# shallow, ~16-32). Two reasons it is set explicitly here:\n#  1. The three app kernels have very different IIs (regime 1, risk 4, momentum\n#     5), so one can run hundreds of ticks ahead of another. A shallow FIFO\n#     fills, that kernel blocks, the blockage backs up through the broadcaster\n#     into inctsvd_top, and the whole pipeline stalls.\n#  2. Depth 512 comfortably exceeds a 299-tick batch, so no stage can be held\n#     up by a downstream one within a single replay.\n# The real deadlock fix is the read-ordering correction in risk_matrix (St\n# before proj, matching momentum and inctsvd_top's write order); these depths\n# are margin on top of it, not a substitute.\n\n# ── ingress ──────────────────────────────────────────────────────────────────\nstream_connect=upd_inject.upd_out:lob_filter.upd_in:2048\n# LOB tick matrix into the SVD (decided ticks only)\nstream_connect=lob_filter.Bt_out:inctsvd_top.Bt_in:256\n# singular values -\u003e all three apps\nstream_connect=inctsvd_top.St_out:bcast_st.in:2048\nstream_connect=bcast_st.out0:momentum_signal.St_in:2048\nstream_connect=bcast_st.out1:risk_matrix.St_in:2048\nstream_connect=bcast_st.out2:regime_classifier.St_in:2048\n# projection magnitudes -\u003e momentum + risk\nstream_connect=inctsvd_top.proj_out:bcast_pm.in:2048\nstream_connect=bcast_pm.out0:momentum_signal.proj_in:2048\nstream_connect=bcast_pm.out1:risk_matrix.proj_in:2048\n# NEW in B: the three app signals -\u003e the on-chip vote\nstream_connect=momentum_signal.res_out:decision_sink.mom_in:2048\nstream_connect=risk_matrix.res_out:decision_sink.rsk_in:2048\nstream_connect=regime_classifier.res_out:decision_sink.rgm_in:2048\n# ── SLR placement ────────────────────────────────────────────────────────────\n# FLIPPED from Option A. A used no HBM and put everything in SLR1 (next to the\n# host/PCIe interface). B's feeder and sink now DMA to/from HBM, and on the U50\n# all 32 HBM segments live in SLR0. Placing the whole chain in SLR0 keeps both\n# the kernel-to-kernel AXI-Stream *and* the new HBM DMA path local; only the\n# low-bandwidth AXI-Lite control crosses to the host interface, which is cheap.\n# The design is ~150k LUT / ~1.2k DSP — a comfortable fit in SLR0\n# (351,840 LUT / 2,352 DSP). If the link fails timing or routing, first try\n# removing these slr= lines to let the placer decide, then try SLR1.\nslr=upd_inject:SLR0\nslr=lob_filter:SLR0\nslr=inctsvd_top:SLR0\nslr=bcast_st:SLR0\nslr=bcast_pm:SLR0\nslr=momentum_signal:SLR0\nslr=risk_matrix:SLR0\nslr=regime_classifier:SLR0\nslr=decision_sink:SLR0\n\n[clock]\nfreqHz=166666666:upd_inject.ap_clk\nfreqHz=166666666:lob_filter.ap_clk\nfreqHz=166666666:inctsvd_top.ap_clk\nfreqHz=166666666:bcast_st.ap_clk\nfreqHz=166666666:bcast_pm.ap_clk\nfreqHz=166666666:momentum_signal.ap_clk\nfreqHz=166666666:risk_matrix.ap_clk\nfreqHz=166666666:regime_classifier.ap_clk\nfreqHz=166666666:decision_sink.ap_clk\n# 166.666 MHz on the shared default clock. If the hw link fails timing, drop to\n# 125000000 and relink — even at the slowest kernel's II that is ~1.2 M\n# decisions/s, far beyond any feed rate.\n# freqHz=166666666:inctsvd_top.ap_clk\n\n[vivado]\nprop=run.impl_1.strategy=Performance_ExplorePostRoutePhysOpt\n"
   }
  ],
  "cwd": "/home/eeuser/quant_accel/source_rr"
 }
}
</ENTRY>
